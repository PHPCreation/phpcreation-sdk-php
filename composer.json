{
    "name": "phpcreation/phpcreation-sdk-php",
    "description": "PHP SDK to interact with the APIs from PHPCreation apps.",
    "type": "library",
    "license": "proprietary",
    "autoload": {
        "psr-4": {
            "PhpCreation\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PhpCreation\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "phpcreation",
            "email": "info@phpcreation.com"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.2",
        "ext-openssl": "*",
        "firebase/php-jwt": "^6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10"
    }
}
